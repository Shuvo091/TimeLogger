@model TimeLogger.Models.ViewModels.SummaryViewModel

<div class="container py-4">
    <h2>Summary</h2>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card text-bg-light">
                <div class="card-body">
                    <h5 class="card-title">Planned (hrs)</h5>
                    <p class="card-text display-6">@Model.TotalPlannedHours</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-light">
                <div class="card-body">
                    <h5 class="card-title">Logged (hrs)</h5>
                    <p class="card-text display-6">@Model.TotalLoggedHours</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-light">
                <div class="card-body">
                    <h5 class="card-title">Completion</h5>
                    <p class="card-text display-6">@Model.CompletionPercentage %</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-light">
                <div class="card-body">
                    <h5 class="card-title">Most focused</h5>
                    <p class="card-text display-6">@Model.MostFocusedTopic</p>
                </div>
            </div>
        </div>
    </div>

    <a class="btn btn-secondary mt-3" asp-action="Index">Back</a>
</div>