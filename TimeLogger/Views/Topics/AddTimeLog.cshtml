@model TimeLogger.Models.ViewModels.TimeLogViewModel
@{
    ViewData["Title"] = "Add Time Log";
}

<div class="container py-4">
    <h2>Add Time Log</h2>

    <form method="post" asp-action="AddTimeLog">
        <div class="mb-3">
            <label class="form-label">Topic</label>
            <select asp-for="TopicId" class="form-select">
                <option value="">-- Select --</option>
                @foreach (var t in Model.Topics ?? Enumerable.Empty<object>())
                {
                    var idProp = t.GetType().GetProperty("Id");
                    var nameProp = t.GetType().GetProperty("Name");
                    if (idProp != null && nameProp != null)
                    {
                        <option value="@idProp.GetValue(t)">@nameProp.GetValue(t)</option>
                    }
                }
            </select>
            <span asp-validation-for="TopicId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DurationMinutes" class="form-label">Duration (minutes)</label>
            <input asp-for="DurationMinutes" class="form-control" />
            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LogDate" class="form-label">Log Date</label>
            <input asp-for="LogDate" type="datetime-local" class="form-control" value="@Model.LogDate.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="LogDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Note" class="form-label">Note</label>
            <textarea asp-for="Note" class="form-control"></textarea>
        </div>

        <button class="btn btn-primary">Add</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}