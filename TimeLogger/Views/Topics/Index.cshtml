@model IEnumerable<TimeLogger.Models.ViewModels.TopicViewModel>
@{
    ViewData["Title"] = "Topics";
    var totalHours = ViewBag.TotalWeeklyHours ?? 0;
    var aggPlanned = ViewBag.AggregatePlanned ?? 0;
    var aggThisWeek = ViewBag.AggregateThisWeek ?? 0;
    var aggAllTime = ViewBag.AggregateAllTime ?? 0;
}

<div class="container py-4">
    <div class="d-flex justify-content-between mb-3">
        <h2>Topics</h2>
        <div>
            <a class="btn btn-primary" asp-action="Create">Add Topic</a>
            <a class="btn btn-secondary" asp-action="AddTimeLog">Add Time Log</a>
            <a class="btn btn-info" asp-action="Summary">Summary</a>
            <a class="btn btn-warning" asp-action="AnalyticsDetailed">Analytics</a>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Allocation %</th>
                <th>Planned Weekly (hrs)</th>
                <th>Hours This Week</th>
                <th>Hours (All time)</th>
                <th>Diff (hrs)</th>
                <th>Efficiency %</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Name</td>
                    <td>@t.Percentage</td>
                    <td>@t.PlannedWeeklyHours</td>
                    <td>@t.TotalHoursThisWeek</td>
                    <td>@t.TotalHoursAllTime</td>
                    <td class="@(t.DifferenceHours < 0 ? "text-danger" : "text-success")">@t.DifferenceHours</td>
                    <td>@t.EfficiencyPercent %</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete topic @t.Name?');">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                        <a class="btn btn-sm btn-outline-success" asp-action="AddTimeLog" asp-route-topicId="@t.Id">Add Log</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td>Total</td>
                <td>-</td>
                <td>@aggPlanned</td>
                <td>@aggThisWeek</td>
                <td>@aggAllTime</td>
                <td>@(Math.Round(aggThisWeek - aggPlanned, 2))</td>
                <td>-</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>