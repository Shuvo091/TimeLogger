@model TimeLogger.Models.ViewModels.CreateEditTopicModel
@{
    var isNew = Model?.Id == Guid.Empty;
    var modeQuery = (Context.Request.Query["mode"].ToString() ?? string.Empty).ToLowerInvariant();
    // allow controller to explicitly ask for edit (ViewBag.EditMode), or fallback to ?mode=edit
    var editFromController = (ViewBag.EditMode as bool?) == true;
    var isEditMode = !isNew && (editFromController || modeQuery == "edit");
    var isReadMode = !isNew && !isEditMode;
    ViewData["Title"] = isNew ? "Create Topic" : (isEditMode ? "Edit Topic" : "Topic");
    var timeLogRows = ViewBag.TimeLogRows as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    if (isNew && string.IsNullOrWhiteSpace(Model?.Readiness))
    {
        // default readiness is set server-side previously; keep in place if desired
    }

    // Read-only metrics provided by controller
    var targetAll = (ViewBag.TargetAllHours as double?) ?? 0.0;
    var completedAll = (ViewBag.CompletedAllHours as double?) ?? 0.0;
    var targetThisWeek = (ViewBag.TargetThisWeek as double?) ?? 0.0;
    var completedThisWeek = (ViewBag.CompletedThisWeek as double?) ?? 0.0;
}

<div class="container py-4">
    <h2>@ViewData["Title"]</h2>

    @* READ MODE: existing topic, display values in a readable card with Update button *@
    @if (isReadMode)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h4 class="card-title">@Model.Name</h4>
                <p class="mb-1"><strong>Allocation:</strong> @Model.Percentage% </p>

                <div class="mt-3">
                    <h6>Readiness</h6>
                    <div class="border rounded p-3" style="white-space:pre-wrap;">
                        @Html.Raw(System.Net.WebUtility.HtmlEncode(Model.Readiness ?? string.Empty).Replace("\r\n", "\n").Replace("\n", "<br/>"))
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6">
                        <h6>All-time progress</h6>
                        <div class="border rounded p-3">
                            <p class="mb-1"><strong>Target:</strong> @targetAll hours</p>
                            <p class="mb-1"><strong>Completed:</strong> @completedAll hours</p>
                            <p class="mb-0"><strong>Completion:</strong> @(targetAll == 0 ? "—" : (Math.Round((completedAll / targetAll) * 100, 2) + "%"))</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6>This week</h6>
                        <div class="border rounded p-3">
                            <p class="mb-1"><strong>Target (this week):</strong> @targetThisWeek hours</p>
                            <p class="mb-1"><strong>Completed (this week):</strong> @completedThisWeek hours</p>
                            <p class="mb-0"><strong>Completion:</strong> @(targetThisWeek == 0 ? "—" : (Math.Round((completedThisWeek / targetThisWeek) * 100, 2) + "%"))</p>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <a class="btn btn-primary" href="@Url.Action("Edit", "Topics", new { id = Model.Id, mode = "edit" })">Update</a>
                    <a class="btn btn-secondary" asp-action="Index">Back</a>
                </div>
            </div>
        </div>
    }

    @* CREATE or EDIT MODE: show form inputs. In create mode -> action Create; in edit mode -> action Edit *@
    @if (isNew || isEditMode)
    {
        <form method="post" asp-action="@(isNew ? "Create" : "Edit")" class="mb-4">
            @if (!isNew)
            {
                <input type="hidden" asp-for="Id" />
            }

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Percentage" class="form-label"></label>
                <input asp-for="Percentage" type="number" min="1" max="100" class="form-control" />
                <span asp-validation-for="Percentage" class="text-danger"></span>
                <div class="form-text">Total across topics must equal 100.</div>
            </div>

            <div class="mb-3">
                <label asp-for="TotalTargetHoursAllTime" class="form-label">Total target hours (all time)</label>
                <input asp-for="TotalTargetHoursAllTime" type="number" step="0.25" min="0" class="form-control" />
                <span asp-validation-for="TotalTargetHoursAllTime" class="text-danger"></span>
                <div class="form-text">Used to calculate the per-topic all-time target: (Percentage / 100) * Total target hours (all time).</div>
            </div>

            <div class="mb-3">
                <label asp-for="Readiness" class="form-label">Readiness (editable, markdown/plain text)</label>
                <textarea asp-for="Readiness" class="form-control" rows="12">@Model.Readiness</textarea>
                <span asp-validation-for="Readiness" class="text-danger"></span>
                <div class="form-text">Use markdown or plain text. This content is stored per-topic and editable here.</div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary">@((isNew) ? "Create" : "Save")</button>
                @if (isNew)
                {
                    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                }
                else
                {
                    <a class="btn btn-outline-secondary" href="@Url.Action("Edit", "Topics", new { id = Model.Id })">Cancel</a>
                }
            </div>
        </form>
    }

    @* Time logs: only visible for persisted topics (not in create mode) - same table as before *@
    @if (!isNew)
    {
        <hr />
        <h4 class="mt-4">Time logs</h4>

        <div class="mb-2">
            <a class="btn btn-sm btn-success" asp-action="AddTimeLog" asp-route-topicId="@Model.Id">Add Time Log</a>
        </div>

        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>Log Date</th>
                    <th>Duration (min)</th>
                    <th>Note</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in timeLogRows)
                {
                    <tr>
                        <td>@r.LogDateLocal</td>
                        <td>@r.DurationMinutes</td>
                        <td>@r.Note</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary edit-log" data-url="@Url.Action("EditTimeLog", "Topics", new { id = r.Id })">Edit</button>

                            <form method="post" asp-action="DeleteTimeLog" class="d-inline">
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="topicId" value="@r.TopicId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this time log?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>

<!-- Modal placeholder -->
<div class="modal fade" id="editTimeLogModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Time Log</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- partial content loaded via AJAX -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            // load edit partial into modal
            $('.edit-log').on('click', function (e) {
                e.preventDefault();
                var url = $(this).data('url');
                $('#editTimeLogModal .modal-body').html('<div class="text-center py-4">Loading...</div>');
                $('#editTimeLogModal').modal('show');
                $.get(url).done(function (html) {
                    $('#editTimeLogModal .modal-body').html(html);
                }).fail(function () {
                    $('#editTimeLogModal .modal-body').html('<div class="text-danger">Failed to load.</div>');
                });
            });
        });
    </script>
}