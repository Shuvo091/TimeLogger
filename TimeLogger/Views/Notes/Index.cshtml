@model IEnumerable<TimeLogger.Models.NoteListItemViewModel>
@{
    ViewData["Title"] = "Notes";
    var scopeFilter = ViewBag.ScopeFilter as SkillAllocationTracker.Domain.Entities.NoteScope?;
    var dateFilter = ViewBag.DateFilter as string ?? "";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notes</h2>
        <div>
            <a class="btn btn-primary" asp-action="Create">New Note</a>
        </div>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <select name="scope" class="form-select">
                <option value="">All scopes</option>
                <option value="Daily" selected="@(scopeFilter == SkillAllocationTracker.Domain.Entities.NoteScope.Daily ? "selected" : null)">Daily</option>
                <option value="Weekly" selected="@(scopeFilter == SkillAllocationTracker.Domain.Entities.NoteScope.Weekly ? "selected" : null)">Weekly</option>
                <option value="Monthly" selected="@(scopeFilter == SkillAllocationTracker.Domain.Entities.NoteScope.Monthly ? "selected" : null)">Monthly</option>
            </select>
        </div>
        <div class="col-auto">
            <input name="date" type="date" class="form-control" value="@dateFilter" />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary">Filter</button>
            <a class="btn btn-outline-secondary" href="/Notes">Reset</a>
        </div>
    </form>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Occurrence</th>
                <th>Scope</th>
                <th>Title</th>
                <th>Excerpt</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.OccurrenceDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td>@n.Scope</td>
                    <td>@n.Title</td>
                    <td>@(string.IsNullOrEmpty(n.Body) ? "—" : (n.Body.Length > 120 ? n.Body.Substring(0, 120) + "…" : n.Body))</td>
                    <td>@n.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@n.Id">Edit</a>
                        <form method="post" asp-action="Delete" class="d-inline">
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this note?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>